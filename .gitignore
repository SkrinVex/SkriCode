# Built application files
*.apk
*.aar
*.ap_
*.aab
!app/src/main/assets/*.apk

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated build directories (do not ignore source packages named 'build')
/build/
app/build/
app-runtime/build/
bin/
gen/
out/

# Gradle files
.gradle/
buildOutput/

# Local configuration file (sdk path, etc)
local.properties
keystore.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log
*.skrilogs

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/
.idea/libraries
.idea/modules.xml
.idea/workspace.xml
.idea/caches
.idea/assetWizardSettings.xml

# CMake / C++ build caches
.cxx/
.externalNativeBuild/

# OS specific
.DS_Store
Thumbs.db

# Secrets & Keystores
*.jks
*.keystore
